# ---------------------------------------------------------------------------
# Environment configuration
#
# Copy to .env and fill in. NEVER commit a real .env: it is git-ignored for a
# reason, and a JWT secret in version control is a permanent compromise.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- API ---
PORT=4000
HOST=0.0.0.0

# --- Database ---
# Development and tests use SQLite (built into Node 24, no native build needed).
# Production uses PostgreSQL.
DB_DIALECT=sqlite
SQLITE_PATH=./data/rhm.db
# DB_DIALECT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/rhm

# --- Authentication ---
# REQUIRED in production, minimum 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# In development an ephemeral secret is generated per process if this is unset.
JWT_SECRET=
JWT_ISSUER=rhm-api
# Seconds. Long by design: a CHW offline for a week must not be logged out.
ACCESS_TOKEN_TTL=604800

# --- Rate limiting ---
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
API_RATE_WINDOW_MS=60000
API_RATE_MAX=600

# --- CORS ---
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Sync ---
SYNC_MAX_BATCH=200

# --- Front-end build-time variables (apps/chw, apps/dashboard) ---
# Leave unset in development: the Vite dev server proxies /api to the API.
# VITE_API_BASE=https://api.example.org/api/v1
